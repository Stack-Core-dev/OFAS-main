# OFAS Backend Environment Configuration
# Copy this file to .env and update values for your environment

# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.app

# Security Keys (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Database
DATABASE_URL=postgresql://ofas:ofas@localhost:5432/ofas
SQLALCHEMY_ECHO=false

# S3/MinIO Configuration
S3_ENDPOINT_URL=http://localhost:4566
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ofas-photos
S3_REGION=us-east-1

# TOTP/Passkey
TOTP_ISSUER=OFAS
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=OFAS
PASSKEY_ORIGIN=http://localhost:5000

# Geospatial / Field Configuration
TRAIL_INTERVAL_SECONDS=300
TRAIL_ACCURACY_THRESHOLD=50.0
FIELD_RADIUS_TOLERANCE=10.0
FACE_MATCH_THRESHOLD=0.6
MAX_PHOTO_SIZE_MB=2
MAX_PHOTOS_PER_VISIT=10
MIN_PHOTOS_PER_VISIT=3

# Sync Configuration
SYNC_BATCH_SIZE=100
VISIT_RETENTION_DAYS=365

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://10.0.2.2:8080

# Logging
LOG_LEVEL=INFO

# Production Super Admin (set these before first deploy)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@ofas.example.com
SUPER_ADMIN_PASSWORD=changeme123!