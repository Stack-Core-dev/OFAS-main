#!/usr/bin/env sh
#
# Gradle start up script for UN*X
#
# Important for running:
# (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#     non-POSIX-compliant, you can either change the shebang to point to a POSIX
#     shell, or run the script as: bash gradlew
# (2) This script must be run from the directory it is located in, or the
#     GRADLE_HOME environment variable must be set to the root of the Gradle
#     installation.
# (3) This script is typically invoked by the Gradle Wrapper, which is a
#     small JAR file that is part of the Gradle distribution.

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD="maximum"

warn () {
    echo "$*"
}

die () {
    echo
    echo "$*"
    echo
    exit 1
}

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "`uname`" in
  CYGWIN* )
    cygwin=true
    ;;
  Darwin* )
    darwin=true
    ;;
  MINGW* )
    msys=true
    ;;
  NONSTOP* )
    nonstop=true
    ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
fi

# Increase the maximum file descriptors if we can.
if [ "$cygwin" = "false" -a "$darwin" = "false" -a "$nonstop" = "false" ] ; then
    MAX_FD_LIMIT=`ulimit -H -n`
    if [ $? -eq 0 ] ; then
        if [ "$MAX_FD" = "maximum" -o "$MAX_FD" = "max" ] ; then
            MAX_FD="$MAX_FD_LIMIT"
        fi
        ulimit -n $MAX_FD
        if [ $? -ne 0 ] ; then
            warn "Could not set maximum file descriptor limit: $MAX_FD"
        fi
    else
        warn "Could not query maximum file descriptor limit: $MAX_FD_LIMIT"
    fi
fi

# For Darwin, add options to specify how the application appears in the dock
if $darwin; then
    GRADLE_OPTS="$GRADLE_OPTS \"-Xdock:name=$APP_NAME\" \"-Xdock:icon=$APP_HOME/media/gradle.icns\""
fi

# For Cygwin or MSYS, switch paths to Windows format before running java
if $cygwin ; then
    APP_HOME=`cygpath --path --mixed "$APP_HOME"`
    CLASSPATH=`cygpath --path --mixed "$CLASSPATH"`
    JAVACMD=`cygpath --unix "$JAVACMD"`
    # We build the pattern for arguments to be converted via cygpath
    ROOTDIRSRAW=`find -L / -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sed -e 's/^/"/' -e 's/$/"/' | tr '\n' ' '`
    ROOTDIRS=`echo $ROOTDIRSRAW | sed -e 's/ /","/g'`
    # Now convert the arguments - kludge to limit cygpath calls
    for ARG in "$@" ; do
        CHECK=`echo "$ARG" | egrep -c '^".*"$'`
        if [ $CHECK -ne 0 ] ; then
            ARG=`echo $ARG | sed -e 's/^"//' -e 's/"$//'`
        fi
        case $ARG in
          /*|~/*)
            ARG=`cygpath --path --mixed "$ARG"`
            ;;
        esac
        shift
        set -- "$@" "$ARG"
    done
fi

# Split up the JVM_OPTS And GRADLE_OPTS values into an array, following the shell quoting and substitution rules
# Function to split a string by whitespace, preserving quoted strings
splitJvmOpts() {
    local str=$1
    local -a arr=()
    local buf=""
    local in_quotes=false
    local quote_char=""
    for (( i=0; i<${#str}; i++ )); do
        char="${str:i:1}"
        if [ "$in_quotes" = false ] && ([ "$char" = '"' ] || [ "$char" = "'" ]); then
            in_quotes=true
            quote_char="$char"
        elif [ "$in_quotes" = true ] && [ "$char" = "$quote_char" ]; then
            in_quotes=false
            quote_char=""
        elif [ "$in_quotes" = false ] && [ "$char" = " " ]; then
            if [ -n "$buf" ]; then
                arr+=("$buf")
                buf=""
            fi
        else
            buf="$buf$char"
        fi
    done
    if [ -n "$buf" ]; then
        arr+=("$buf")
    fi
    echo "${arr[@]}"
}

# Collect all arguments for the java command
# Use a while loop to handle arguments with spaces
set -- "$@" "-Dorg.gradle.appname=$APP_BASE_NAME" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain

# Stop if we're in a non-interactive shell
# exec "$JAVACMD" "$@"

# By default, we use the JVM options from the environment
JVM_OPTS=()
if [ -n "$DEFAULT_JVM_OPTS" ]; then
    JVM_OPTS=($DEFAULT_JVM_OPTS)
fi
if [ -n "$JAVA_OPTS" ]; then
    JVM_OPTS+=($JAVA_OPTS)
fi
if [ -n "$GRADLE_OPTS" ]; then
    JVM_OPTS+=($GRADLE_OPTS)
fi

exec "$JAVACMD" "${JVM_OPTS[@]}" "$@"